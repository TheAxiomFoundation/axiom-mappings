{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom-mappings/findings.schema.json",
  "title": "Known disagreements, each recorded once",
  "type": "object",
  "required": [
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program",
          "variable",
          "counterpart",
          "cause"
        ],
        "properties": {
          "program": {
            "type": "string"
          },
          "variable": {
            "type": "string"
          },
          "counterpart": {
            "enum": [
              "policyengine",
              "taxsim",
              "other"
            ]
          },
          "cause": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom-mappings/prefixes.schema.json",
  "title": "Axiom id prefixes classified together",
  "type": "object",
  "required": [
    "prefixes"
  ],
  "additionalProperties": false,
  "properties": {
    "prefixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "rationale"
        ],
        "properties": {
          "axiom_prefix": {
            "type": "string"
          },
          "program": {
            "type": "string"
          },
          "type": {
            "enum": [
              "not_comparable",
              "direct_variable",
              "derived_expression"
            ]
          },
          "candidate_priority": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "policyengine_variable": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "comparison": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "axiom": {
            "type": "string",
            "description": "oracles lists a few prefixes under legal_id; kept verbatim"
          }
        },
        "anyOf": [
          {
            "required": [
              "axiom_prefix"
            ]
          },
          {
            "required": [
              "axiom"
            ]
          }
        ]
      }
    }
  }
}

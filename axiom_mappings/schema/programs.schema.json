{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom-mappings/programs.schema.json",
  "title": "Programs whose readiness is tracked",
  "type": "object",
  "required": [
    "programs"
  ],
  "additionalProperties": false,
  "properties": {
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jurisdiction",
          "axiom"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+/[a-z0-9-]+$"
          },
          "jurisdiction": {
            "type": "string"
          },
          "axiom": {
            "type": "string"
          },
          "window": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "consumers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "corpus_ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "rulespec-us commit this program is read at; the map's rulespec_us pin when absent"
          },
          "assembled_by": {
            "type": "string",
            "description": "consumer code that assembles the program from many modules (then `axiom` is that consumer's id, not a RuleSpec module)"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom-mappings/taxonomy.schema.json",
  "title": "Why Axiom and a counterpart disagree (D48)",
  "type": "object",
  "required": [
    "causes",
    "crosswalk"
  ],
  "additionalProperties": false,
  "properties": {
    "causes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "meaning",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "meaning": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "blocks": {
            "type": "boolean",
            "description": "a disagreement with this cause keeps a program from serving Axiom's answer (D48)"
          }
        }
      }
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}

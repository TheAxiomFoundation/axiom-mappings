{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom-mappings/transforms.schema.json",
  "title": "Derived slot transforms, and the law or assumptions they carry",
  "type": "object",
  "required": ["transforms"],
  "additionalProperties": false,
  "properties": {
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "meaning"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "kind": {"enum": ["arithmetic", "reference-data", "assumption", "law-in-rule", "law-in-code"]},
          "meaning": {"type": "string"},
          "law": {"type": "array", "items": {"type": "string"}},
          "values": {"type": "object"},
          "implemented_in": {"type": "string"}
        },
        "allOf": [{"if": {"properties": {"kind": {"const": "law-in-code"}}}, "then": {"required": ["law", "values"]}}]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom-mappings/concepts.schema.json",
  "title": "Shared input concepts",
  "type": "object",
  "required": [
    "concepts"
  ],
  "additionalProperties": false,
  "properties": {
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "entity",
          "measure",
          "policyengine"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[^#\\s]+#[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "entity": {
            "enum": [
              "person",
              "household",
              "case",
              "tax_unit",
              "spm_unit",
              "family",
              "marital_unit"
            ]
          },
          "measure": {
            "enum": [
              "flow",
              "stock",
              "flag",
              "level",
              "category",
              "count"
            ],
            "description": "flow sums over time; stock is a level at a point in time; flag is boolean; level is a non-additive number such as age; category is a code"
          },
          "unit": {
            "type": "string"
          },
          "policyengine": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entity",
                "variable"
              ],
              "properties": {
                "entity": {
                  "enum": [
                    "person",
                    "household",
                    "case",
                    "tax_unit",
                    "spm_unit",
                    "family",
                    "marital_unit"
                  ]
                },
                "variable": {
                  "type": "string"
                }
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom-mappings/supplied_parameters.schema.json",
  "title": "Parameter values a harness supplies because the Axiom encoding lacks them",
  "type": "object",
  "required": [
    "supplied_parameters"
  ],
  "additionalProperties": false,
  "properties": {
    "supplied_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program",
          "name",
          "value",
          "effective_from",
          "source",
          "supplied_by",
          "reason"
        ],
        "properties": {
          "program": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {},
          "effective_from": {
            "type": "string",
            "format": "date"
          },
          "unit": {
            "type": "string"
          },
          "dtype": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "supplied_by": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "encoding-gap"
            ]
          },
          "upstream_issue": {
            "type": "string"
          }
        }
      }
    }
  }
}
